---
import { site } from "../../site.config.ts";
const year = new Date().getFullYear();
---

<footer class="border-t" style="border-color: var(--c-border)">
  <div class="container flex flex-col gap-2 py-6 text-sm muted sm:flex-row sm:justify-between">
    <span>{site.businessName} © {year}</span>
    <span>{site.address} · {site.hours}</span>
  </div>
</footer>
