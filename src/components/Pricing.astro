---
import { site } from "../../site.config.ts";

const priced = site.services.filter((service) => service.price);
---

{
  site.showPricing && (
    <section id="pricing" class="section">
      <div class="container">
        <h2 class="text-2xl font-bold">Цены</h2>
        {priced.length > 0 ? (
          <ul class="mt-6 divide-y divide-black/10 rounded-xl border border-black/10" style="background: var(--c-surface)">
            {priced.map((service) => (
              <li class="flex items-center justify-between p-4">
                <span>{service.title}</span>
                <span class="font-semibold">{service.price}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 opacity-80">{site.pricingNote ?? "Цены уточняйте по телефону."}</p>
        )}
      </div>
    </section>
  )
}
