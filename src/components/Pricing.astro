---
import { site } from "../../site.config.ts";

const priced = site.services.filter((service) => service.price);
---

{
  site.showPricing && (
    <section id="pricing" class="section">
      <div class="container">
        <h2 class="text-2xl font-bold">Цены</h2>
        {priced.length > 0 ? (
          <ul class="card mt-5" style="padding:0;overflow:hidden">
            {priced.map((service, index) => (
              <li
                class="flex items-center justify-between gap-4 px-4 py-3"
                style={index > 0 ? "border-top:1px solid var(--c-border)" : ""}
              >
                <span>{service.title}</span>
                <span class="font-semibold" style="color: var(--c-primary-strong)">
                  {service.price}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 muted">{site.pricingNote ?? "Цены уточняйте по телефону."}</p>
        )}
        {site.pricingNote && priced.length > 0 && <p class="mt-3 text-sm muted">{site.pricingNote}</p>}
      </div>
    </section>
  )
}
