---
import { site } from "../../site.config.ts";
import { telHref } from "../lib/format.ts";
---

<header class="border-b" style="border-color: var(--c-border); background: var(--c-surface)">
  <div class="container flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-4">
    <a href="#top" class="text-lg font-bold no-underline" style="color: var(--c-ink)">
      {site.businessName}
    </a>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <a href="#services">Услуги</a>
      {site.showPricing && <a href="#pricing">Цены</a>}
      <a href="#faq">Вопросы</a>
      <a href="#contacts">Контакты</a>
      <a class="btn btn-primary hidden sm:inline-flex" href={telHref(site.phone)}>Позвонить</a>
    </nav>
  </div>
</header>
