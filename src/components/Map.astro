---
import { site } from "../../site.config.ts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const m = site.map;
const d = 0.01;
const bbox = `${m.lon - d}%2C${m.lat - d}%2C${m.lon + d}%2C${m.lat + d}`;
const embed = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${m.lat}%2C${m.lon}`;
---

<section id="map" class="section">
  <div class="container">
    <h2 class="text-2xl font-bold">Как нас найти</h2>
    <p class="mt-3">{site.address}</p>
    <p class="muted">{site.hours}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      {m.links.map((link) => <a class="btn btn-ghost" href={link.url} rel="noopener">{link.label}</a>)}
    </div>

    {
      m.provider === "osm-embed" ? (
        <div data-map-wrap class="card mt-4" style="padding:0;overflow:hidden">
          <div class="flex flex-col items-center gap-3 p-4">
            <img src={`${base}images/demo-map.svg`} alt="Иллюстрация карты (Demo)" width="640" height="300" />
            <button
              type="button"
              class="btn btn-primary"
              data-map-embed={embed}
              data-map-title={`Карта: ${m.label}`}
            >
              Показать карту
            </button>
            <p class="text-sm muted">{m.label}</p>
          </div>
        </div>
      ) : (
        <p class="mt-4 muted">Откройте карту по ссылке выше.</p>
      )
    }

    <noscript>
      <p class="mt-3"><a href={m.links[0]?.url}>Открыть карту</a> (для встроенной карты нужен JavaScript).</p>
    </noscript>
    <p class="mt-3 text-sm muted">
      <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap contributors</a>
    </p>
    <script src={`${base}map.js`} defer></script>
  </div>
</section>
