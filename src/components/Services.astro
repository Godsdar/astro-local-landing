---
import { site } from "../../site.config.ts";
---

<section id="services" class="section" style="background: color-mix(in srgb, var(--c-ink) 4%, transparent)">
  <div class="container">
    <h2 class="text-2xl font-bold">Услуги</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.services.map((service) => (
          <article class="rounded-xl border border-black/10 p-4">
            <h3 class="font-semibold">{service.title}</h3>
            <p class="mt-2 text-sm opacity-80">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
