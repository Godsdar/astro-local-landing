---
import { site } from "../../site.config.ts";
---

<section class="section">
  <div class="container">
    <h2 class="text-2xl font-bold">Как мы работаем</h2>
    <ol class="process mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        site.process.map((step, index) => (
          <li>
            <span class="step-dot" aria-hidden="true">{index + 1}</span>
            <div class="card mt-3">
              <h3 class="font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
