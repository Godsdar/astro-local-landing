---
import { site } from "../../site.config.ts";
---

<section class="section" style="background: color-mix(in srgb, var(--c-ink) 4%, transparent)">
  <div class="container">
    <h2 class="text-2xl font-bold">Как мы работаем</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        site.process.map((step, index) => (
          <li class="rounded-xl border border-black/10 p-4">
            <span class="text-sm font-semibold" style="color: var(--c-primary)">
              Шаг {index + 1}
            </span>
            <h3 class="mt-1 font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm opacity-80">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
