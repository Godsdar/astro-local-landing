---
import { site } from "../../site.config.ts";
import { telHref, waHref, tgHref } from "../lib/format.ts";
const base = import.meta.env.BASE_URL;
---

<section id="top" class="section">
  <div class="container grid gap-8 md:grid-cols-2 md:items-center">
    <div>
      <h1 class="text-3xl font-bold md:text-4xl">{site.businessName}</h1>
      <p class="mt-3 text-lg">{site.tagline}</p>
      <p class="mt-3 opacity-80">{site.description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        {site.whatsapp && <a class="btn btn-primary" href={waHref(site.whatsapp, "Здравствуйте, хочу записаться")}>Записаться</a>}
        <a class="btn btn-accent" href={telHref(site.phone)}>Позвонить</a>
        {site.telegram && <a class="btn btn-ghost" href={tgHref(site.telegram)}>Telegram</a>}
      </div>
    </div>
    <img
      src={`${base}images/demo-hero.svg`}
      alt="Demo hero"
      width="640"
      height="420"
      class="w-full rounded-xl"
    />
  </div>
</section>
