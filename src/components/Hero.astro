---
import { site } from "../../site.config.ts";
import { telHref, waHref, tgHref } from "../lib/format.ts";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section id="top" class="section">
  <div class="container grid gap-8 md:grid-cols-[1.05fr_0.95fr] md:items-center">
    <div class="prose">
      <h1 class="text-3xl font-bold md:text-4xl">{site.businessName}</h1>
      <p class="mt-3 text-lg">{site.tagline}</p>
      <p class="mt-3 muted">{site.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {
          site.whatsapp && (
            <a class="btn btn-primary" href={waHref(site.whatsapp, "Здравствуйте, хочу записаться")}>
              Записаться
            </a>
          )
        }
        <a class="btn btn-ghost" href={telHref(site.phone)}>Позвонить</a>
        {site.telegram && <a class="text-sm" href={tgHref(site.telegram)}>Написать в Telegram</a>}
      </div>
    </div>
    <img
      src={`${base}images/demo-hero.svg`}
      alt="Иллюстрация для примера (Demo)"
      width="640"
      height="420"
      class="w-full rounded-xl border"
      style="border-color: var(--c-border)"
    />
  </div>
</section>
