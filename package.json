{
  "name": "local-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local business landing starter (Demo). Astro + TypeScript + Tailwind + Vitest.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
