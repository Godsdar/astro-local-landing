# Security headers template for Cloudflare Pages and Netlify (both read a file named _headers).
# The GitHub Pages demo keeps the same policy inside a <meta> tag in the HTML head.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-src https://www.openstreetmap.org; base-uri 'self'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
